// VGA Demoscene for Tiny Tapeout
// 640x480@60Hz using TinyVGA PMOD
// 50 MHz input clock, divided to 25 MHz pixel clock

/// VGA timing generator for 640x480@60Hz
/// Returns (h_count, v_count, hsync, vsync, visible)
entity vga_sync(clk: clock, rst: bool) -> (uint<10>, uint<10>, bool, bool, bool) {
    // Divide 50 MHz clock by 2 for 25 MHz pixel clock
    reg(clk) pixel_en reset(rst: false) = !pixel_en;

    // Horizontal counter: 0-799 (800 pixels per line)
    reg(clk) h_count reset(rst: 0) = if pixel_en {
        if h_count == 799 { 0 } else { h_count +. 1 }
    } else {
        h_count
    };

    // Vertical counter: 0-524 (525 lines per frame)
    reg(clk) v_count reset(rst: 0) = if pixel_en {
        if h_count == 799 {
            if v_count == 524 { 0 } else { v_count +. 1 }
        } else {
            v_count
        }
    } else {
        v_count
    };

    // Sync signals (active low)
    let hsync = !(h_count >= 656 && h_count < 752);
    let vsync = !(v_count >= 490 && v_count < 492);
    let visible = h_count < 640 && v_count < 480;

    (h_count, v_count, hsync, vsync, visible)
}

/// Generates pixel colors based on screen position
/// Returns (R1, R0, G1, G0, B1, B0)
entity pixel_color(x: uint<10>, y: uint<10>, visible: bool) -> (bool, bool, bool, bool, bool, bool) {
    if visible {
        // Three vertical color stripes: Red, Green, Blue
        if x < 213 {
            (true, true, false, false, false, false)
        } else if x < 426 {
            (false, false, true, true, false, false)
        } else {
            (false, false, false, false, true, true)
        }
    } else {
        (false, false, false, false, false, false)
    }
}

/// Top-level Tiny Tapeout module
#[no_mangle(all)]
entity tt_um_zufallsgenerat0r_demo(
    clk: clock,
    rst_n: bool,
    ui_in: [bool; 8],
    uo_out: inv& [bool; 8],
    uio_in: uint<8>,
    uio_out: inv& [bool; 8],
    uio_oe: inv& [bool; 8],
    ena: bool,
) {
    // Spade uses active high reset
    let rst = !rst_n;

    // Bidirectional pins unused
    set uio_out = &[false; 8];
    set uio_oe = &[false; 8];

    // VGA timing and pixel generation
    let (h, v, hsync, vsync, visible) = inst vga_sync(clk, rst);
    let (r1, r0, g1, g0, b1, b0) = inst pixel_color(h, v, visible);

    // TinyVGA PMOD pinout: [R1, R0, G1, G0, B1, B0, hsync, vsync]
    set uo_out = &[r1, r0, g1, g0, b1, b0, hsync, vsync];
}
